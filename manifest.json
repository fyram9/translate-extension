{
  "manifest_version": 3,
  "name": "AI Translate",
  "version": "1.0.0",
  "description": "Translate selected text with AI via OpenRouter. Right-click any selected text and choose 'Translate selection'.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-translate@fahmy.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}